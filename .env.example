# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public site origin used for canonical URLs, Open Graph URLs, and sitemap entries.
SITE_URL="http://localhost:3000"

# Keep search engines out of the site until launch. Set to false on launch.
NOINDEX_SITE="true"

# Ad slots remain hidden unless enabled and an AdSense client ID is provided.
ADS_ENABLED="false"
ADSENSE_CLIENT_ID=""
